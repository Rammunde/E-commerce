# Server Configuration
PORT=5000
PORTAL_NAME=Shopveda

# Email Service
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password

# Database Configuration
# Local MongoDB example: mongodb://0.0.0.0:27017
# MongoDB Atlas example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://0.0.0.0:27017
ECOMMERCE=shopveda

# Semantic Search & Vector Embeddings Configuration
#
# Priority: OpenAI (if key set) → Local Transformers.js model (free, no API key needed)
#
# Option 1: OpenAI Embeddings (paid, 1536 dimensions)
# Obtain your OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Option 2: Local Embedding Model (free, 384 dimensions, runs on CPU)
# Uses @huggingface/transformers with ONNX Runtime — no API key required.
# The model is downloaded and cached automatically on first use (~80MB).
# Default: Xenova/all-MiniLM-L6-v2 (sentence-transformers/all-MiniLM-L6-v2)
LOCAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# MongoDB Atlas Vector Search Index Name (Default: vector_index)
# NOTE: If switching between OpenAI (1536d) and local model (384d),
# you must recreate the Atlas vector search index with the correct dimensions.
MONGODB_ATLAS_VECTOR_INDEX=vector_index

# Razorpay Payment Gateway Configuration (Test Mode)
# Get your API keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

